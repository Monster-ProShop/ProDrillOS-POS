DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prodrillos?schema=public"
APP_URL="http://localhost:3000"
POS_USERNAME="staff"
POS_PASSWORD="replace-with-a-long-random-password"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
SHOP_TIMEZONE="America/Mexico_City"
# This starter supports two-decimal currencies, e.g. usd or mxn.
SHOP_CURRENCY="mxn"
NEXT_PUBLIC_SHOP_CURRENCY="MXN"
# Official logo copied from ProDrillOS.com; override when rebranding.
NEXT_PUBLIC_BRAND_LOGO="/brand/prodrillos-logo.png"

# Neon: pooled URL above for requests, direct URL below for migrations.
DATABASE_URL_UNPOOLED=""
# Gateway credentials remain server-side; public IDs are served by /api/store/config.
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
MERCADOPAGO_ENV="sandbox"
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_WEBHOOK_SECRET=""
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
RESEND_API_KEY=""
EMAIL_FROM=""
